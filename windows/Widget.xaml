<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      UseLayoutRounding="True" SnapsToDevicePixels="True" TextElement.FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
      TextElement.FontSize="14" TextElement.Foreground="{DynamicResource Ink}">
  <Grid.Resources>
    <Style x:Key="QuietButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource Focus}"/><Setter TargetName="Plate" Property="BorderThickness" Value="0.5"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>
  <Border x:Name="Surface" Background="{DynamicResource Surface}" CornerRadius="8" Padding="18,12,18,14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid x:Name="TitleArea" Margin="0,0,0,17" MinHeight="32">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="TitleText" Text="4G 网卡" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button x:Name="More" Grid.Column="1" Style="{StaticResource QuietButton}" ToolTip="更多" AutomationProperties.Name="更多选项">
          <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE712;" FontSize="14"/>
        </Button>
        <Button x:Name="Hide" Grid.Column="2" Style="{StaticResource QuietButton}" ToolTip="收起到托盘" AutomationProperties.Name="收起到托盘">
          <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="12"/>
        </Button>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="Power" Width="72" Height="72" Cursor="Hand" Background="{DynamicResource Off}" Foreground="{DynamicResource Muted}" AutomationProperties.Name="切换网卡模式">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Tile" Background="{TemplateBinding Background}" CornerRadius="20">
                <Viewbox Width="29" Height="29">
                  <Grid Width="24" Height="24">
                    <Path Data="M 7,4.5 A 8.5,8.5 0 1 0 17,4.5 M 12,2 L 12,11" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Grid>
                </Viewbox>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tile" Property="Opacity" Value="0.8"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Focus}"/><Setter TargetName="Tile" Property="BorderThickness" Value="0.5"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock x:Name="Headline" Text="正在识别" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="Status" Text="请稍候" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
      </Grid>
      <TextBlock x:Name="Notice" Grid.Row="2" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12" Visibility="Collapsed"/>
      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Detail" Text="DJI 4G" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button x:Name="Refresh" Grid.Column="1" Style="{StaticResource QuietButton}" ToolTip="刷新状态" AutomationProperties.Name="刷新状态">
          <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14"/>
        </Button>
      </Grid>
    </Grid>
  </Border>
</Grid>
